{
  "name": "passport-muestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pasaporte digital para la muestra escolar del 28 de octubre. Cloudflare Workers + D1 (SQLite).",
  "scripts": {
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute passport-db --local --file=migrations/0001_init.sql",
    "db:seed": "wrangler d1 execute passport-db --local --file=seed/seed.sql",
    "db:demo": "wrangler d1 execute passport-db --local --file=seed/seed-data.sql"
  },
  "devDependencies": {
    "html5-qrcode": "^2.3.8",
    "qrcode-generator": "^1.4.4"
  }
}