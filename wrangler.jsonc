{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passport-muestra",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "pasaporte.onlyfunpeople.com.ar", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passport-db",
      "database_id": "34c0cbd2-6a26-46b2-aff6-79e975f520e0"
    }
  ]
}