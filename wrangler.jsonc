{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passport-muestra",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passport-db",
      "database_id": "dev-local"
    }
  ]
}